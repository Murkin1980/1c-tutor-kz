{
  "name": "1c-tutor-kz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:functions": "wrangler pages functions build functions --project-directory . --outdir node_modules/.tmp/pages-functions --compatibility-date 2026-08-25 --compatibility-flag nodejs_compat",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.functions.json --pretty false",
    "format:check": "prettier --check src/app src/entities/courseSelectors.ts src/entities/courseSelectors.test.ts src/features/auth src/features/verification/verify.ts src/features/verification/verify.test.ts src/routes/CoursePage.tsx src/routes/DashboardPage.tsx src/routes/LessonPage.tsx src/routes/LessonPage.test.tsx src/routes/LoginPage.tsx e2e/lesson-flow.spec.ts e2e/customer-card-workspace.spec.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "check:curriculum": "node scripts/check-curriculum.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "driver.js": "^1.8.0",
    "jose": "^6.2.10",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.7.0",
    "tailwindcss": "^4.1.11",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.54.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.15",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.125.0"
  }
}
